{
  "name": "depugame",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws",
      "/healthz"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POKER_ROOMS",
        "class_name": "PokerRooms"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PokerRooms"
      ]
    }
  ]
}
